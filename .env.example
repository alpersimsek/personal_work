# ==============================================================================
# Tuğba Ergüner Şimşek Web App - Environment Configuration Template
# ==============================================================================

ALLOWED_ORIGIN="http://localhost:3000"
NODE_ENV="development"

# Local MySQL/MariaDB (matches the target Node.js hosting environment,
# which provisions MariaDB 10.6+ databases). Started via `docker compose
# up -d`. Point the future backend at these same variable names — the
# production Node.js app on cPanel reads the identical names from its
# own environment-variables panel, so the same code runs unmodified in
# both places.
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="tugba_app"
DB_USER="tugba_app"
DB_PASSWORD="tugba_app"
DB_ROOT_PASSWORD="rootpassword"

# API backend configuration
API_PORT="3001"
# Signs session tokens. The server refuses to start unless it is at least 32
# characters, random-looking and not a placeholder. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="change-me-to-a-long-random-string"
# Optional, only while rotating: the secret being retired. Tokens signed with it
# are still accepted, new ones never are. Remove it after 12 hours.
# JWT_SECRET_PREVIOUS=""
ADMIN_USERNAME="admin"
# At least 12 characters with a digit or symbol; the seed refuses weaker or leaked values.
ADMIN_PASSWORD="change-me-to-a-strong-password-1"

# Persistent image storage (local default: ./uploads; hosting: absolute path outside code checkout)
UPLOADS_DIR="./uploads"
