# ==============================================================================
# Tuğba Ergüner Şimşek Web App - Environment Configuration Template
# ==============================================================================

ALLOWED_ORIGIN="http://localhost:3000"
NODE_ENV="development"

# The public address of the site (no trailing slash). Canonical links, the sitemap, robots.txt
# and share previews use it. Leave it unset locally: the address of each request is used.
# In production set it to the real domain; the server refuses to start without it:
# PUBLIC_SITE_URL="https://www.tugbasimsek.com.tr"

# Local MySQL/MariaDB (matches the target Node.js hosting environment,
# which provisions MariaDB 10.6+ databases). Started via `docker compose
# up -d`. Point the future backend at these same variable names — the
# production Node.js app on cPanel reads the identical names from its
# own environment-variables panel, so the same code runs unmodified in
# both places.
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="tugba_app"
DB_USER="tugba_app"
DB_PASSWORD="tugba_app"
DB_ROOT_PASSWORD="rootpassword"

# API backend configuration
API_PORT="3001"
# Signs session tokens. The server refuses to start unless it is at least 32
# characters, random-looking and not a placeholder. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="change-me-to-a-long-random-string"
# Optional, only while rotating: the secret being retired. Tokens signed with it
# are still accepted, new ones never are. Remove it after 12 hours.
# JWT_SECRET_PREVIOUS=""
ADMIN_USERNAME="admin"
# At least 12 characters with a digit or symbol; the seed refuses weaker or leaked values.
ADMIN_PASSWORD="change-me-to-a-strong-password-1"

# Persistent image storage (local default: ./uploads; hosting: absolute path outside code checkout)
UPLOADS_DIR="./uploads"

# Gmail SMTP for newsletter verification. Use a dedicated Google App Password;
# never use the Gmail account's normal password. Keep these values server-side.
NEWSLETTER_SMTP_USER="newsletter@example.com"
NEWSLETTER_SMTP_APP_PASSWORD="16-character-app-password"
NEWSLETTER_FROM="Tuğba Şimşek Ergüner <newsletter@example.com>"

# Newsletter broadcast (emails verified subscribers when a blog post is published).
# The worker is ON by default only when NODE_ENV=production and OFF elsewhere, so
# a development server never mails real subscribers. Set "true" to test sending
# locally, or "false" to switch it off in production.
# NEWSLETTER_WORKER_ENABLED="true"
# Minutes between publishing and sending; unpublishing inside it cancels the send.
# NEWSLETTER_DELAY_MINUTES="10"
# Messages sent per one-minute tick.
# NEWSLETTER_BATCH_SIZE="20"
# Messages per rolling 24 hours; Gmail allows about 500.
# NEWSLETTER_DAILY_CAP="400"
# Days the unsubscribe link in each email stays valid.
# NEWSLETTER_UNSUBSCRIBE_TTL_DAYS="30"
