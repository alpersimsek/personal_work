# ==============================================================================
# Shanti Web App - Environment Configuration Template
# ==============================================================================

# Google Calendar API Credentials
# Obtained from Google Cloud Console -> Service Account or OAuth 2.0 Credentials
GOOGLE_CALENDAR_ID="your-email@gmail.com"
GOOGLE_CLIENT_EMAIL="shanti-calendar-sa@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# API Security & Shielding Settings
# Restricts API access strictly to your official domain origin
ALLOWED_ORIGIN="http://localhost:3000"
NODE_ENV="development"
