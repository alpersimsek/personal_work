# ==============================================================================
# Tuğba Ergüner Şimşek Web App - Environment Configuration Template
# ==============================================================================

ALLOWED_ORIGIN="http://localhost:3000"
NODE_ENV="development"

# Blog admin panel login. NOTE: this app has no backend — anything set
# here still ends up readable inside the compiled client bundle, so it
# must be a password used nowhere else, never a real personal password.
# Generate a hash with:
#   node -e "console.log(require('crypto').createHash('sha256').update('yourPassword').digest('hex'))"
VITE_ADMIN_USERNAME="admin"
VITE_ADMIN_PASSWORD_SHA256=""

# Local MySQL/MariaDB (matches the target Node.js hosting environment,
# which provisions MariaDB 10.6+ databases). Started via `docker compose
# up -d`. Point the future backend at these same variable names — the
# production Node.js app on cPanel reads the identical names from its
# own environment-variables panel, so the same code runs unmodified in
# both places.
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="tugba_app"
DB_USER="tugba_app"
DB_PASSWORD="tugba_app"
DB_ROOT_PASSWORD="rootpassword"

# API backend configuration
API_PORT="3001"
JWT_SECRET="change-me-to-a-long-random-string"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
